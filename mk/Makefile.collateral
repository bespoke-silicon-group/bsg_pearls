
define bsg_fn_design_gen

BUILD_SOURCES += work/bsg_chip_pkg.sv work/bsg_chip_defines.svh
VPKG += work/bsg_chip_pkg.sv

%/bsg_chip_pkg.sv: $(BSG_DESIGN_PY_DIR)/bsg_chip_pkg.py
	@$(MKDIR) -p $$(@D)
	@PYTHONPATH=$$(<D) $(PYTHON) -c \
		"from bsg_chip_pkg import BsgChipPkg; print(BsgChipPkg().get_pkg())" > $$@

%/bsg_chip_pkg.tcl: $(BSG_DESIGN_PY_DIR)/bsg_chip_pkg.py
	@$(MKDIR) -p $$(@D)
	@PYTHONPATH=$$(<D) $(PYTHON) -c \
		"from bsg_chip_pkg import BsgChipPkg; print(BsgChipPkg().get_tcl())" > $$@

%/bsg_chip_defines.svh: $(BSG_DESIGN_PY_DIR)/bsg_chip_pkg.py
	@$(MKDIR) -p $$(@D)
	@PYTHONPATH=$$(<D) $(PYTHON) -c \
		"from bsg_chip_pkg import BsgChipPkg; print(BsgChipPkg().get_svheader())" > $$@
	
%/bsg_chip_defines.hpp: $(BSG_DESIGN_PY_DIR)/bsg_chip_pkg.py
	@$(MKDIR) -p $$(@D)
	@PYTHONPATH=$$(<D) $(PYTHON) -c \
		"from bsg_chip_pkg import BsgChipPkg; print(BsgChipPkg().get_cheader())" > $$@

%/bsg_pearls_setup.tcl:
	@$(MKDIR) -p $$(@D)
	@$(ECHO) "# Autogenerated by $(lastword $(MAKEFILE_LIST)): DO NOT MODIFY"       > $$@
	@$(ECHO) "set ::env(PDK_ROOT) $(PDK_ROOT)"                                     >> $$@
	@$(ECHO) "set ::env(PDK) $(PDK)"                                               >> $$@
	@$(ECHO) "set ::env(PDK_LIB) $(PDK_LIB)"                                       >> $$@
	@$(ECHO) "set ::env(PDK_CORNER) $(PDK_CORNER)"                                 >> $$@
	@$(ECHO) "set ::env(BSG_PEARLS_DIR) $(BSG_PEARLS_DIR)"                         >> $$@
	@$(ECHO) "set ::env(BSG_PEARLS_TCL_DIR) $(BSG_PEARLS_TCL_DIR)"                   >> $$@
	@$(ECHO) "set ::env(BSG_DESIGN_TCL_DIR) $(BSG_DESIGN_TCL_DIR)"                 >> $$@
	@$(ECHO) "set ::env(BSG_WORK_DIR) $(CURDIR)/work"                              >> $$@

%/bsg_design_setup.tcl:
	@$(MKDIR) -p $$(@D)
	@$(ECHO) "# Autogenerated by $(lastword $(MAKEFILE_LIST)): DO NOT MODIFY"       > $$@
	@$(ECHO) "set ::env(VDEFINES) [list \\"                                              >> $$@;
	@for i in $$(VDEFINES); do \
		$(ECHO) "$(bsg_var_tab)$$$$i \\"                                     >> $$@; \
	done
	@$(ECHO) "]"                                                                 >> $$@
	@$(ECHO) "set ::env(VINCLUDES) [list \\"                                     >> $$@;
	@for i in $$(VINCLUDES); do \
		$(ECHO) "$(bsg_var_tab)$$$$i \\" >> $$@; \
	done
	@$(ECHO) "]"                                                                 >> $$@
	@$(ECHO) "set ::env(VPKG) [list \\"                                      >> $$@;
	@for i in $$(notdir $$(VPKG)); do \
		$(ECHO) "$(bsg_var_tab)\$$$$::env(BSG_WORK_DIR)/vpkg/$$$$i \\"            >> $$@; \
	done
	@$(ECHO) "]"                                                                 >> $$@
	@$(ECHO) "set ::env(VSOURCES) [list \\"                                      >> $$@;
	@for i in $$(notdir $$(VSOURCES)); do \
		$(ECHO) "$(bsg_var_tab)\$$$$::env(BSG_WORK_DIR)/vlog/$$$$i \\"            >> $$@; \
	done
	@$(ECHO) "]"                                                                 >> $$@
	@$(ECHO) "set ::env(HARD_VSOURCES) [list \\"                                 >> $$@;
	@for i in $$(notdir $$(HARD_VSOURCES)); do \
		$(ECHO) "$(bsg_var_tab)\$$$$::env(BSG_WORK_DIR)/hard/$$$$i \\"            >> $$@; \
	done
	@$(ECHO) "]"                                                                 >> $$@
	@$(ECHO) "set ::env(HARD_NSOURCES) [list \\"                                 >> $$@;
	@for i in $$(notdir $$(HARD_NSOURCES)); do \
		$(ECHO) "$(bsg_var_tab)\$$$$::env(BSG_WORK_DIR)/hard/$$$$i \\"            >> $$@; \
	done
	@$(ECHO) "]"                                                                 >> $$@
	@$(ECHO) "set ::env(DESIGN) $(BSG_DESIGN)" >> $$@
	@$(ECHO) "set ::env(WRAPPER) $(BSG_WRAPPER)" >> $$@
	@$(SED) -i "s#$(BSG_PEARLS_DIR)#\$$$$\::env(BSG_PEARLS_DIR)#g" $$@

clean::
	@$(RM) -rf bsg_pearls_setup.tcl
	@$(RM) -rf bsg_chip_pkg.sv
	@$(RM) -rf bsg_chip_pkg.tcl
	@$(RM) -rf bsg_chip_defines.svh
	@$(RM) -rf bsg_chip_defines.hpp
	@$(RM) -rf work

endef

