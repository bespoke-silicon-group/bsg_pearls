
# $(1) -> corner
define bsg_fn_chip_gen

$(1)/bsg_chip_pkg.sv: $(BSG_DESIGN_PY_DIR)/bsg_chip_pkg.py
	@$(MKDIR) -p $$(@D)
	@PYTHONPATH=$$(<D) $(PYTHON) -c \
		"from bsg_chip_pkg import BsgChipPkg; print(BsgChipPkg().get_pkg())" > $$@

$(1)/bsg_chip_pkg.tcl: $(BSG_DESIGN_PY_DIR)/bsg_chip_pkg.py
	@$(MKDIR) -p $$(@D)
	@PYTHONPATH=$$(<D) $(PYTHON) -c \
		"from bsg_chip_pkg import BsgChipPkg; print(BsgChipPkg().get_tcl())" > $$@

$(1)/bsg_chip_defines.svh: $(BSG_DESIGN_PY_DIR)/bsg_chip_pkg.py
	@$(MKDIR) -p $$(@D)
	@PYTHONPATH=$$(<D) $(PYTHON) -c \
		"from bsg_chip_pkg import BsgChipPkg; print(BsgChipPkg().get_svheader())" > $$@
	
$(1)/bsg_chip_defines.hpp: $(BSG_DESIGN_PY_DIR)/bsg_chip_pkg.py
	@$(MKDIR) -p $$(@D)
	@PYTHONPATH=$$(<D) $(PYTHON) -c \
		"from bsg_chip_pkg import BsgChipPkg; print(BsgChipPkg().get_cheader())" > $$@

$(1)/bsg_pearls_setup.tcl:
	@$(MKDIR) -p $$(@D)
	@$(ECHO) "# Autogenerated by $(lastword $(MAKEFILE_LIST)): DO NOT MODIFY"       > $$@
	@$(ECHO) "set ::env(PDK_ROOT) $(PDK_ROOT)"                                     >> $$@
	@$(ECHO) "set ::env(PDK) $(PDK)"                                               >> $$@
	@$(ECHO) "set ::env(PDK_LIB) $(PDK_LIB)"                                       >> $$@
	@$(ECHO) "set ::env(PDK_CORNER) $(PDK_CORNER)"                                 >> $$@
	@$(ECHO) "set ::env(BSG_CHIP_TCL_DIR) $(BSG_PEARLS_TCL_DIR)"                   >> $$@

clean::
	@$(RM) -rf $(1)/bsg_pearls_setup.tcl
	@$(RM) -rf $(1)/bsg_chip_pkg.sv
	@$(RM) -rf $(1)/bsg_chip_pkg.tcl
	@$(RM) -rf $(1)/bsg_chip_defines.svh
	@$(RM) -rf $(1)/bsg_chip_defines.hpp


endef

# $(1) -> corner
define bsg_fn_design_gen

$(1)/bsg_design_setup.tcl:
	@$(MKDIR) -p $$(@D)
	@$(ECHO) "# Autogenerated by $(lastword $(MAKEFILE_LIST)): DO NOT MODIFY"       > $$@
	@$(ECHO) "set ::env(BSG_DESIGN_TCL_DIR) $(BSG_DESIGN_TCL_DIR)"                 >> $$@
	@$(ECHO) "set ::env(BSG_LOG_LEVEL) $$($(1)_LOGLEVEL)"                          >> $$@
	@$(ECHO) "set ::env(VDEFINES) [list \\"                                        >> $$@
	@for def in $$(VDEFINES); do                                                           \
		$(ECHO) "$(bsg_var_tab)$$$$def \\"                                     >> $$@; \
	done
	@$(ECHO) "]"                                                                   >> $$@
	@$(ECHO) "set ::env(VINCLUDES) [list]"                                         >> $$@
	@$(ECHO) "set ::env(VSOURCES) [list \\"                                        >> $$@
	@for v in $$(abspath syn/wrapper.pickled.sv); do                                       \
		$(ECHO) "$(bsg_var_tab)$$$$v \\"                                       >> $$@; \
	done
	@$(ECHO) "]"                                                                   >> $$@
	@$(ECHO) "set ::env(NSOURCES) [list \\"                                        >> $$@
	@for n in $$(HARD_NSOURCES); do                                                        \
		$(ECHO) "$(bsg_var_tab)$$$$n \\"                                       >> $$@; \
	done
	@$(ECHO) "]"                                                                   >> $$@
	@$(ECHO) "set ::env(DESIGN) $(BSG_DESIGN)"                                     >> $$@
	@$(ECHO) "set ::env(WRAPPER) $(WRAPPER)"                                       >> $$@
	@$(ECHO) ""                                                                    >> $$@

clean::
	@$(RM) -rf $(1)/bsg_design_setup.tcl

endef

$(eval $(call bsg_fn_chip_gen,syn))
$(eval $(call bsg_fn_chip_gen,basic))
$(eval $(call bsg_fn_chip_gen,test))
$(eval $(call bsg_fn_chip_gen,vlog))
$(eval $(call bsg_fn_chip_gen,hard))
$(eval $(call bsg_fn_chip_gen,syn-elab))
$(eval $(call bsg_fn_chip_gen,syn-gen))
$(eval $(call bsg_fn_chip_gen,syn-opt))
$(eval $(call bsg_fn_chip_gen,syn-tech))
$(eval $(call bsg_fn_chip_gen,syn-final))

basic_LOGLEVEL   := 2
debug_LOGLEVEL   := 3
iterate_LOGLEVEL := 99

$(eval $(call bsg_fn_design_gen,basic))
$(eval $(call bsg_fn_design_gen,debug))
$(eval $(call bsg_fn_design_gen,iterate))

